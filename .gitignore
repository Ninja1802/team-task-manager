# Root .gitignore — team-task-manager

# Node dependencies
node_modules/

# Environment files (NEVER commit these)
.env
.env.local
.env.production
.env.*.local

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.user

# Vite cache
.vite/
